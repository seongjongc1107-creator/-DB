# 사내 서버(JFPS PC) 자체 호스팅용 환경변수. 실제 값은 .env로 복사해서 채울 것 (git에는 안 올라감).

# 관리자 기능(근간 데이터 업로드, 커퓨 업로드, 지금 업데이트) 비밀번호 — 없으면 해당 API들이 500 에러를 냄
ADMIN_PASSWORD=

# uvicorn이 바인딩할 포트 — GYSJ(JFPS)가 이미 8000을 쓰므로 겹치지 않게 8001 권장
PORT=8001

# metar_archive.db / fpl_archive.db 경로를 바꾸고 싶을 때만 설정 (기본값은 backend/ 바로 아래)
# DATABASE_URL=sqlite+aiosqlite:///./metar_archive.db
# FPL_DATABASE_URL=sqlite+aiosqlite:///./fpl_archive.db
